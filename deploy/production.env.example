# Copy this file to the repository root as .env. Replace every example value.
DEMO_DOMAIN=books.example.com

# Use a dedicated MongoDB Atlas user with read access to online_bookstore.
# URL-encode special characters in the password.
BACKUP_MONGODB_URI=mongodb+srv://BACKUP_USER:REPLACE_WITH_URL_ENCODED_PASSWORD@cluster.example.mongodb.net/online_bookstore?retryWrites=true&w=majority
BACKUP_HOST_DIR=./backups

# Keep payments on Razorpay by default. The simulator is a documented demo-only exception.
PAYMENT_PROVIDER=razorpay
ALLOW_PAYMENT_SIMULATOR=false

# Optional; use the same value for subsequent image builds to make rollback straightforward.
APP_IMAGE_TAG=local
