# Copy this file to server/.env and fill in real values.
# server/.env is git-ignored: secrets must never be committed (SRS 6.3).

NODE_ENV=development
PORT=5000

# MongoDB connection string (SRS 2.4, 3.2). The server must be a replica set, because
# orders use transactions (SASD 3.3); see "MongoDB must be a replica set" in README.md.
MONGODB_URI=mongodb://127.0.0.1:27017/online_bookstore
# Base URI used by the automated tests; each Jest worker appends its own database name
MONGODB_TEST_URI=mongodb://127.0.0.1:27017

# JWT signing key (SRS 6.3) - use a long random value
JWT_SECRET=replace-with-a-long-random-secret

# The only origin allowed to make cross-origin requests (SRS 3.3)
CLIENT_ORIGIN=http://localhost:5173

# bcrypt work factor, minimum 10 (SRS 6.3)
BCRYPT_ROUNDS=12

# First administrator, created by `npm run seed:admin`
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Select Stripe test mode for gateway-backed checkout; simulator remains available for demos.
PAYMENT_PROVIDER=simulator
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Optional SMTP delivery for buyer order e-mails (STARTTLS on port 587).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
