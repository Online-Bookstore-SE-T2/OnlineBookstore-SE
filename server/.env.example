# Copy this file to server/.env and fill in real values.
# server/.env is git-ignored: secrets must never be committed (SRS 6.3).

NODE_ENV=development
PORT=5000

# MongoDB connection string (SRS 2.4, 3.2). The server must be a replica set, because
# orders use transactions (SASD 3.3); see "MongoDB must be a replica set" in README.md.
MONGODB_URI=mongodb://127.0.0.1:27017/online_bookstore
# Base URI used by the automated tests; each Jest worker appends its own database name
MONGODB_TEST_URI=mongodb://127.0.0.1:27017

# JWT signing key (SRS 6.3) - use a long random value
JWT_SECRET=replace-with-a-long-random-secret

# The only origin allowed to make cross-origin requests (SRS 3.3)
CLIENT_ORIGIN=http://localhost:5173

# bcrypt work factor, minimum 10 (SRS 6.3)
BCRYPT_ROUNDS=12

# First administrator, created by `npm run seed:admin`
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Set PAYMENT_PROVIDER=razorpay for Razorpay test-mode checkout; simulator remains available for demos.
# Keys: Razorpay Dashboard → Test Mode → Account & Settings → API Keys. Never commit real values.
PAYMENT_PROVIDER=simulator
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Production normally requires Razorpay. Set to true to run a production deployment (e.g. the hosted
# demo) on the built-in payment simulator instead; no real or test money moves. Deviation from the SRS.
ALLOW_PAYMENT_SIMULATOR=false

# Optional SMTP delivery for buyer order e-mails (STARTTLS on port 587).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional address that receives monitoring alerts by e-mail (SASD 4.4.3, docs/monitoring.md).
# Uses the SMTP settings above; alerts are always written to the server log as well.
ALERT_EMAIL=
